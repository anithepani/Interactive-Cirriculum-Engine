# ============================================================
# Interactive Curriculum Engine - environment template
# Copy to `.env` and fill in. Never commit the real `.env`.
# ============================================================

# ---- Runtime ----
ENV=dev
LOG_LEVEL=INFO
APP_NAME=ice
# Comma-separated list of allowed CORS origins (frontend URL)
CORS_ORIGINS=http://localhost:3000
# Uvicorn auto-reload in the dev API container. Empty/unset = OFF (stable,
# avoids the watchfiles "Cannot allocate memory" crash). Set to 1 to enable
# hot reload (scoped to apps/ + libs/).
UVICORN_RELOAD=

# ---- PostgreSQL 16 + pgvector ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ice
POSTGRES_USER=ice
POSTGRES_PASSWORD=ice_dev_password
DATABASE_URL=postgresql+asyncpg://ice:ice_dev_password@localhost:5432/ice
# Set to enable row-level security enforcement at the app layer
DB_RLS_ENABLED=true

# ---- Redis 7 (cache + Celery broker) ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- MinIO / S3 (video, frames, artifacts; tenant-scoped prefixes) ----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=ice_minio
S3_SECRET_KEY=ice_minio_secret
S3_REGION=us-east-1
S3_BUCKET=ice-artifacts
S3_USE_PATH_STYLE=true

# ---- judge0 code sandbox (MVP) ----
JUDGE0_URL=http://localhost:2358
JUDGE0_API_TOKEN=judge0_dev_token
# CPU (s) / memory (KB) / wall-clock caps per submission
SANDBOX_CPU_LIMIT=2
SANDBOX_MEMORY_LIMIT=262144
SANDBOX_TIME_LIMIT=5
SANDBOX_NETWORK_DISABLED=true

# ---- Auth (OAuth + JWT, per-tenant) ----
JWT_SECRET=change_me_in_prod
JWT_SECRET_KEY=change_me_in_prod
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=60
JWT_REFRESH_TTL_DAYS=7
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
FRONTEND_URL=http://localhost:3000
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# ---- SMTP (email verification) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=
# Support/feedback portal destination inbox (empty = log to console in dev)
SUPPORT_EMAIL=
# SSE stream auth token secret (empty = reuse JWT_SECRET)
SSE_TOKEN_SECRET=

# ---- LLM / AI (Hybrid strategy) ----
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Groq 429 rate-limit handling: exponential backoff + jitter.
# sleep = GROQ_BACKOFF_INITIAL * 2**attempt + jitter (capped at 60s).
GROQ_MAX_RETRIES=5
GROQ_BACKOFF_INITIAL=2.0
OPENAI_API_KEY=
OPENAI_MODEL_PRIMARY=gpt-4o
# Fallback / bulk / sovereignty path
OPENROUTER_API_KEY=
LLM_FALLBACK_PROVIDER=togetherai
LLM_FALLBACK_MODEL=meta-llama/Llama-3.1-70B-Instruct
LLM_CODE_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
# Per-curriculum token budget (cost control)
LLM_TOKEN_BUDGET_PER_CURRICULUM=250000

# ---- ASR / Vision (self-hosted GPU node) ----
ASR_MODEL=tiny              # tiny | base | small | medium | large-v3 (CPU dev: tiny)
ASR_DEVICE=cpu              # cuda | cpu  (team laptops have no GPU)
ASR_COMPUTE_TYPE=int8       # int8 (cpu) | int8_float16 | float16 (cuda)
OCR_ENGINE=rapidocr      # rapidocr | paddleocr | trocr | tesseract
OCR_GPU_ENABLED=false
# Optional Real-ESRGAN upscaling for low-res code frames
UPSCALE_LOWRES_FRAMES=false

# ---- M3 Vision (CPU-optimized defaults; target <2min for a 10min video) ----
VISION_EXTRACT_RATE_SEC=5.0        # seconds between sampled frames (higher = faster)
VISION_DEDUP_THRESHOLD=0.06        # stricter near-dup suppression (held slides collapse)
VISION_OCR_CONFIDENCE_THRESHOLD=0.7
VISION_ENABLE_HEAVY_FALLBACKS=false # Set true ONLY for debugging (enables ESPCN + TrOCR)
VISION_MAX_WORKERS=0               # 0 = auto (cap at min(os.cpu_count(), 4))
VISION_MAX_FRAMES=60               # hard cap on frames per video (OCR budget)
VISION_OCR_MAX_WIDTH=768           # downscale wide frames before OCR (0 = off)
VISION_ONNX_INTRA_OP_THREADS=1     # pin ONNX threads; avoids core oversubscription
VISION_MAX_FALLBACK_FRAMES=3       # cap heavy fallback path (only if ENABLE_HEAVY_FALLBACKS)

# ---- Signal video (cinematic summary; nice-to-have, CPU-safe) ----
SIGNAL_VIDEO_ENABLED=true         # master toggle; false = skip + mark status=skipped
SIGNAL_VIDEO_ENGINE=remotion      # remotion (animated, needs Node) | ffmpeg (static)
SIGNAL_VIDEO_MAX_SLIDES=6         # cap Gemini-selected sentences (render time bound)
SIGNAL_VIDEO_TRANSCRIPT_CHARS=12000 # chars of transcript sent to Gemini
SIGNAL_VIDEO_WIDTH=1280           # render width (was 1920)
SIGNAL_VIDEO_HEIGHT=720           # render height (was 1080)
SIGNAL_VIDEO_TTS_COMMAND=edge-tts # must be on PATH; preflighted at task start
SIGNAL_VIDEO_TTS_VOICE=en-US-ChristopherNeural
SIGNAL_VIDEO_REMOTION_COMMAND=/app/apps/remotion/node_modules/.bin/remotion

# ---- Recap video resource limits ----
RECAP_VIDEO_WIDTH=854             # 480p baseline for CPU-only workers
RECAP_VIDEO_HEIGHT=480
RECAP_VIDEO_FPS=24
RECAP_VIDEO_THREADS=1
RECAP_VIDEO_CRF=28
RECAP_VIDEO_MAX_CLIPS=12

# ---- Pipeline / token economics ----
MAX_VIDEO_DURATION_SEC=14400   # 4h cap
MIN_VIDEO_DURATION_SEC=30     # reject <30s
PIPELINE_CHUNK_WINDOW_SEC=300 # 5-min windows for long videos
CHECKPOINT_MIN_GAP_SEC=90     # density cap
CHECKPOINT_AVOID_FINAL_SEC=30
# Gate M8 (test generation + mutation validation). Off for first end-to-end on CPU.
PIPELINE_RUN_TESTS=false

# ---- YouTube bot-detection bypass (PO Token provider sidecar) ----
# bgutil-ytdlp-pot-provider generates per-video Proof-of-Origin tokens so
# yt-dlp can download from datacenter IPs without cookies. The sidecar runs
# as a separate container (see docker-compose.prod.yml: pot-provider).
# Cookies are NOT used — they kept getting rotated/invalidated on the server.
YT_POT_PROVIDER_BASE_URL=http://pot-provider:4416
# Ordered player clients to try on bot-block (mweb+PO token is maintainer-recommended).
YT_PLAYER_CLIENTS=mweb,web_safari,tv

# ---- Monitoring ----
SENTRY_DSN=
PROMETHEUS_METRICS_PORT=9090
GRAFANA_ADMIN_PASSWORD=grafana_dev
