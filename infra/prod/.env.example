# ============================================================
# ICE Production Environment Template
# Copy to .env on the VM (/opt/ice/.env) and fill in real values.
# Generate secrets with: openssl rand -hex 32
# NEVER commit the real .env (it is gitignored).
# ============================================================

# ---- Runtime ----
ENV=production
LOG_LEVEL=INFO
APP_NAME=ice

# ---- CORS (comma-separated; update with your Vercel URL after frontend deploy) ----
CORS_ORIGINS=https://ice-web.vercel.app

# ---- Frontend URL (used for post-OAuth redirect: {FRONTEND_URL}/auth/callback) ----
FRONTEND_URL=https://ice-web.vercel.app

# ---- Database (Neon pooled connection — +asyncpg driver REQUIRED by the app) ----
# db/env.py derives the sync Alembic URL by replacing "+asyncpg" with "+psycopg".
# Using bare "postgresql://" will break both the async engine and migrations.
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<pooler-host>.neon.tech/<db>?sslmode=require

# ---- Redis / Celery (Upstash, TLS required — same URL for all three) ----
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379
CELERY_BROKER_URL=rediss://default:<password>@<host>.upstash.io:6379
CELERY_RESULT_BACKEND=rediss://default:<password>@<host>.upstash.io:6379

# ---- S3 / MinIO (self-hosted on the VM) ----
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=ice_minio
S3_SECRET_KEY=ice_minio_secret
S3_REGION=us-east-1
S3_BUCKET=ice-artifacts
S3_USE_PATH_STYLE=true
# Browser-facing endpoint for presigned URLs (the VM's public IP)
MINIO_EXTERNAL_ENDPOINT=http://<VM_PUBLIC_IP>:9000

# ---- LLM keys ----
GROQ_API_KEY=<your Groq API key>
GEMINI_API_KEY=<your Gemini API key>

# ---- Auth / JWT (generate with: openssl rand -hex 32) ----
JWT_SECRET=<64 hex chars>
SSE_TOKEN_SECRET=<different 64 hex chars>

# ---- Google OAuth ----
GOOGLE_OAUTH_CLIENT_ID=<your Google OAuth client ID>
GOOGLE_OAUTH_CLIENT_SECRET=<your Google OAuth client secret>
GOOGLE_OAUTH_REDIRECT_URI=https://<VM_PUBLIC_IP>.sslip.io/api/v1/auth/google/callback

# ---- SMTP ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your gmail address>
SMTP_PASSWORD=<your app-specific password>
FROM_EMAIL=<your from email>
SUPPORT_EMAIL=<your support email>

# ---- Sandbox (subprocess = run code on the API host; demo-only, NOT multi-user safe) ----
SANDBOX_BACKEND=subprocess

# ---- GHCR (used by docker-compose.prod.yml interpolation + migrate.sh) ----
GHCR_OWNER=<your GitHub username>
IMAGE_TAG=latest
