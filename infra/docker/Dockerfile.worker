# syntax=docker/dockerfile:1.7
# Celery worker image. Same base as api; different entrypoint.
FROM python:3.11-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/ice-venv

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libpq-dev curl ca-certificates ffmpeg \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends \
        nodejs \
        libnss3 libdbus-1-3 libatk1.0-0 libasound2 libxss1 \
        libxrandr2 libxext6 libxdamage1 libxcomposite1 libx11-xcb1 \
        libxcb1 libxcursor1 libxi6 libxrender1 libxtst6 \
        libglib2.0-0 libgtk-3-0 libgbm-dev \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

COPY pyproject.toml uv.lock* ./
COPY libs/ ./libs/
COPY apps/api/pyproject.toml ./apps/api/
COPY apps/worker/pyproject.toml ./apps/worker/
RUN uv sync --no-dev --frozen 2>/dev/null || uv sync --no-dev

COPY apps/api ./apps/api
COPY apps/worker ./apps/worker
COPY apps/remotion ./apps/remotion
RUN cd apps/remotion && npm install

COPY libs ./libs
COPY db ./db

# Install workspace packages (with deps) into the venv that uv run uses.
RUN uv pip install -p /opt/ice-venv ./libs/contracts ./libs/shared ./apps/api ./apps/worker

CMD ["uv", "run", "celery", "-A", "ice_worker.celery_app", "worker", "-l", "info"]
