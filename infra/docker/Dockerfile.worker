# syntax=docker/dockerfile:1.7
# Celery worker image. Same base as api; different entrypoint.
FROM python:3.11-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/ice-venv

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libpq-dev curl ca-certificates ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

COPY pyproject.toml uv.lock* ./
COPY libs/ ./libs/
COPY apps/api/pyproject.toml ./apps/api/
COPY apps/worker/pyproject.toml ./apps/worker/
RUN uv sync --no-dev --frozen 2>/dev/null || uv sync --no-dev

COPY apps/api ./apps/api
COPY apps/worker ./apps/worker
COPY libs ./libs
COPY db ./db

CMD ["uv", "run", "celery", "-A", "ice_worker.celery_app", "worker", "-l", "info"]
