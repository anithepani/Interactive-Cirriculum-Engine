# syntax=docker/dockerfile:1.7
# Shared Python base image: FastAPI + Celery workers + all libs/* + apps/api + apps/worker.
# GPU-heavy deps (faster-whisper, paddleocr) live on the AI image variant (Phase 1).
FROM python:3.11-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/ice-venv

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libpq-dev curl ca-certificates ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

# Cache deps first
COPY pyproject.toml uv.lock* ./
COPY libs/ ./libs/
COPY apps/api/pyproject.toml ./apps/api/
COPY apps/worker/pyproject.toml ./apps/worker/
# Bake in alembic (dev-only dep) + pydantic guarantee so migrations run without
# a runtime install step. pydantic is normally pulled transitively via ice-shared,
# but we pin it explicitly as a belt-and-suspenders against --no-dev edge cases.
RUN uv sync --no-dev --frozen 2>/dev/null || uv sync --no-dev \
 && uv pip install --system alembic pydantic

# App source
COPY apps/api ./apps/api
COPY apps/worker ./apps/worker
COPY libs ./libs
COPY db ./db

CMD ["uv", "run", "uvicorn", "ice_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
