# syntax=docker/dockerfile:1.7
# Shared Python base image: FastAPI + Celery workers + all libs/* + apps/api + apps/worker.
# GPU-heavy deps (faster-whisper, paddleocr) live on the AI image variant (Phase 1).
FROM python:3.11-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/ice-venv

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libpq-dev curl ca-certificates ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

# Cache deps first
COPY pyproject.toml uv.lock* ./
COPY libs/ ./libs/
COPY apps/api/pyproject.toml ./apps/api/
COPY apps/api/README.md ./apps/api/
COPY apps/worker/pyproject.toml ./apps/worker/
RUN uv sync --package ice-api --no-dev --frozen 2>/dev/null || uv sync --package ice-api --no-dev

# App source
COPY apps/api ./apps/api
COPY apps/worker ./apps/worker
COPY libs ./libs
COPY db ./db

# Re-sync with source present so the workspace packages themselves resolve.
RUN uv sync --package ice-api --no-dev --frozen 2>/dev/null || uv sync --package ice-api --no-dev \
 && uv pip install -p /opt/ice-venv uvicorn

CMD ["uv", "run", "--no-sync", "uvicorn", "ice_api.main:app", "--host", "0.0.0.0", "--port", "8000"]